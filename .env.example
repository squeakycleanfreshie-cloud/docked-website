PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me

# GitHub OAuth app -> callback: BASE_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Hackatime OAuth app (hackatime.hackclub.com) -> callback: BASE_URL/auth/hackatime/callback
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

# Week 1 start (include a UTC offset). Each jam runs 7 days from here
CHALLENGE_START=2026-10-26T00:00:00+11:00

# 10 points per extra hour
POINTS_PER_HOUR=10

# true = allows POST /api/demo/log-hours (fake hours, testing only)
DEMO_MODE=false
